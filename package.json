{
  "name": "ya-lost-music",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "url": "https://github.com/k1og/ya_lost_music",
  "scripts": {
    "compile": "tsc",
    "build": "rm -rf ./dist && yarn compile",
    "build-packages": "cp package.json dist/package.json && cp yarn.lock dist/yarn.lock && cd dist && yarn install --production",
    "start": "yarn build && node ./dist/index.js",
    "test": "jest",
    "sync-schema": "yarn build && typeorm schema:sync -d dist/db.js"
  },
  "dependencies": {
    "axios": "^1.2.3",
    "node-schedule": "^2.1.1",
    "node-telegram-bot-api": "^0.61.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.5",
    "@types/node-schedule": "^2.1.0",
    "@types/node-telegram-bot-api": "^0.57.6",
    "jest": "^30.0.5",
    "msw": "^2.10.5",
    "ts-jest": "^29.4.1",
    "typescript": "^4.9.4"
  }
}
